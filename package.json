{
  "name": "better-moodle",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @better-moodle/worker dev",
    "dev:web": "bun --filter @better-moodle/web dev",
    "dev:worker": "bun --filter @better-moodle/worker dev",
    "build": "bun run build:shared && bun run build:web",
    "build:shared": "bun --filter @better-moodle/shared build",
    "build:web": "bun --filter @better-moodle/web build",
    "gate:check": "bun ./scripts/check-moodle-gate.ts",
    "get-token": "bun ./scripts/get-token.ts",
    "test:mutation": "bun ./scripts/run-mutation-tests.ts",
    "audit:dist": "bun ./scripts/audit-dist.ts",
    "secrets:push": "bun ./scripts/push-secrets.ts",
    "deploy:dry-run": "bun run build && bun run audit:dist && bun --cwd apps/worker wrangler deploy --dry-run",
    "deploy": "bun run build && bun run audit:dist && bun --cwd apps/worker wrangler deploy",
    "tail": "bun --cwd apps/worker wrangler tail",
    "vapid:generate": "bun --cwd apps/worker pushforge vapid",
    "d1:migrate:local": "bun --filter @better-moodle/worker d1:migrate:local",
    "d1:migrate:prod": "bun --filter @better-moodle/worker d1:migrate:prod"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "wrangler": "^4.161.0"
  }
}
